<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for Sonara Android (Debug Variant).

    Permits cleartext HTTP traffic ONLY to the local development backend
    (10.0.2.2 = Android Emulator loopback, physical LAN development hosts).

    This configuration applies exclusively to debug builds and is never included
    in release artifacts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- Local backend dev server (Emulator, ADB Reverse, and Physical LAN IP) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.0.2</domain>
        <domain includeSubdomains="false">192.168.0.3</domain>
        <domain includeSubdomains="false">192.168.0.4</domain>
        <domain includeSubdomains="false">192.168.0.5</domain>
    </domain-config>
</network-security-config>
