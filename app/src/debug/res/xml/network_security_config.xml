<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for Sonara Android (Debug Variant).

    Debug builds may use cleartext HTTP for a developer-selected local backend
    (ADB reverse, emulator loopback, or a per-machine LAN origin passed at build time).
    The release/main resource remains HTTPS-only.

    This configuration applies exclusively to debug builds and is never included
    in release artifacts.
-->
<network-security-config>
    <!-- Debug-only local development; release uses src/main/res and stays HTTPS-only. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
