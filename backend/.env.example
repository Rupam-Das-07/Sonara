PORT=3002
NODE_ENV=production
PYTHON_YTMUSIC_URL=http://127.0.0.1:5000
PYTHON_AUDIO_URL=http://127.0.0.1:5001

# Rate limiting
SEARCH_RATE_LIMIT_MAX=60
STREAM_RESOLVE_RATE_LIMIT_MAX=20
GLOBAL_RATE_LIMIT_MAX=200

# Timeouts (milliseconds)
YTMUSIC_TIMEOUT_MS=8000
STREAM_RESOLVE_TIMEOUT_MS=30000
SEARCH_TIMEOUT_MS=12000

# Optional Upstream Override
# JIOSAAVN_V2_BASE=https://jiosaavn.rajputhemant.dev/api
